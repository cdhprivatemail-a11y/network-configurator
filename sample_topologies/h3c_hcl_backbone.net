{
  "simulator": "H3C Cloud Lab (HCL)",
  "version": "5.10.0",
  "project_name": "H3C_Dual_Core_Backbone",
  "devices": [
    {"id": "n1", "name": "RouterA", "model": "MSR36-20", "console_port": 2001, "x": 260, "y": 80, "role": "router"},
    {"id": "n2", "name": "RouterB", "model": "MSR36-20", "console_port": 2002, "x": 620, "y": 80, "role": "router"},
    {"id": "n3", "name": "RouterC", "model": "MSR36-20", "console_port": 2003, "x": 260, "y": 240, "role": "router"},
    {"id": "n4", "name": "RouterD", "model": "MSR36-20", "console_port": 2004, "x": 620, "y": 240, "role": "router"},
    {"id": "n5", "name": "H3C-SW1", "model": "S5820V2-54QS-GE", "console_port": 2005, "x": 440, "y": 380, "role": "switch"}
  ],
  "links": [
    {"src": "RouterA", "src_port": "GigabitEthernet0/0", "dst": "RouterB", "dst_port": "GigabitEthernet0/0"},
    {"src": "RouterB", "src_port": "GigabitEthernet0/1", "dst": "RouterD", "dst_port": "GigabitEthernet0/0"},
