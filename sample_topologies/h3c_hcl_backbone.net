    {"src": "RouterC", "src_port": "GigabitEthernet0/1", "dst": "RouterA", "dst_port": "GigabitEthernet0/1"},
    {"src": "RouterC", "src_port": "GigabitEthernet0/2", "dst": "H3C-SW1", "dst_port": "GigabitEthernet1/0/49"},
    {"src": "RouterD", "src_port": "GigabitEthernet0/2", "dst": "H3C-SW1", "dst_port": "GigabitEthernet1/0/50"}
  ]
